# Образец. Скопировать в .env (он в .gitignore) и заполнить на машине, где идёт бот.

# живой счёт Binance (ключ, выпущенный в кабинете Tiger): торговля — да, вывод — нет, IP — привязать
BINANCE_API_KEY=
BINANCE_API_SECRET=

# тестовая сеть: ключи с https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# бюджет бота в USDT
TRADE_CAPITAL=1000

# третий замок живого режима: yes — разрешить
TRADE_LIVE=no

# оповещения: бот от @BotFather и id чата
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
